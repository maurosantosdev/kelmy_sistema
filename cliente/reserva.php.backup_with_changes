</div>

<script>
// Check if user has already accepted cookies
if (!localStorage.getItem('cookiesAccepted')) {
    // Show cookie consent modal after a delay
    setTimeout(function() {
        const cookieModal = document.getElementById('cookie-consent-modal');
        if (cookieModal) {
            // Use Bootstrap modal if available
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                const modal = new bootstrap.Modal(cookieModal);
                modal.show();
            } else {
                // Fallback: show modal using CSS
                cookieModal.style.display = 'block';
                cookieModal.classList.add('show');
                document.body.style.overflow = 'hidden';
            }
        }
    }, 2000); // Show after 2 seconds
}

// Handle cookie acceptance
document.getElementById('accept-cookies').addEventListener('click', function() {
    localStorage.setItem('cookiesAccepted', 'true');
    const cookieModal = document.getElementById('cookie-consent-modal');

    // Hide modal
    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        const modal = bootstrap.Modal.getInstance(cookieModal) || new bootstrap.Modal(cookieModal);
        modal.hide();
    } else {
        cookieModal.style.display = 'none';
        cookieModal.classList.remove('show');
        document.body.style.overflow = '';
    }
});



