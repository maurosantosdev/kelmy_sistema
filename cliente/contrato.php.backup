                    Swal.fire({
                        title: 'Erro!',
                        text: 'Erro ao fazer logout. Por favor, tente novamente.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            },
            error: function(xhr, status, error) {
                console.error('Logout error:', error);
                console.error('XHR status:', status);
                console.error('Response text:', xhr.responseText);
                // Mesmo em caso de erro, redirecionar para login
                window.location.href = 'login.php';
            }
        });
    });

    // Check if content is visible
    setTimeout(function() {
        console.log('Checking if contract content is visible...');
        console.log('Contract content element exists:', $('.contract-content').length > 0);
        console.log('Contract content element is visible:', $('.contract-content').is(':visible'));
        console.log('Contract content element display property:', $('.contract-content').css('display'));
        console.log('Contract content element height:', $('.contract-content').height());
        console.log('Number of contract clauses:', $('.contract-clause').length);
        console.log('Number of contract sections:', $('.contract-section').length);
    }, 1000);
});
</script>
<!-- CONTRATO.PHP DEBUG: HTML output completed -->

</body>
</html>