            console.error('Error loading user info:', error);
            console.error('XHR status:', status);
            console.error('Response text:', xhr.responseText);
            document.getElementById('header-title-contrato').textContent = 'Contrato de Locação';
        }
    });
}

// Função para garantir visibilidade do conteúdo do contrato
function ensureContractVisibility() {
    console.log('Ensuring contract visibility...');

    // Verificar e forçar visibilidade dos principais elementos
    $('#main-contract-area').show().css({
        'display': 'block !important',
        'visibility': 'visible !important',
        'opacity': '1 !important',
        'height': 'auto !important'
    });

    $('.contract-content').show().css({
        'display': 'block !important',
