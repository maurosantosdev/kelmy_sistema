    console.log('Main contract area exists:', $('#main-contract-area').length > 0);
    console.log('Contract content exists:', $('.contract-content').length > 0);
    console.log('Contract sections count:', $('.contract-section').length);
    console.log('Contract clauses count:', $('.contract-clause').length);

    // Forçar renderização
    setTimeout(function() {
        $('#main-contract-area')[0].offsetHeight;
