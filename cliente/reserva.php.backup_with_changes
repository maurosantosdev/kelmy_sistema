<script>
// Variável global para armazenar a data atual do calendário
let currentDate = new Date();

// Função para carregar dados da agenda (tornada global para ser acessível fora do pageinit)
function loadAgendaData(date) {
    const month = date.getMonth() + 1;
    const year = date.getFullYear();
    console.log("Carregando agenda para mês:", month, "ano:", year);
    const timestamp = new Date().getTime(); // Adiciona timestamp para evitar cache
    fetch(`../php/cliente_agenda.php?action=get_month&month=${month}&year=${year}&t=${timestamp}`)
        .then(response => {
            console.log("Resposta recebida:", response.status);
            return response.json();
        })
        .then(response => {
            console.log("Dados recebidos:", response);
            if (response && response.success && typeof response.prices === 'object') {
                renderReservaCalendar(date, response.prices);
            } else {
                console.error("Falha ao carregar dados do calendário: ", response.message);
            }
        })
        .catch(error => {
            console.error("Erro de comunicação com o servidor: ", error);
        });
}

// Função para carregar dados da agenda e restaurar seleções
function loadAgendaDataAndRestoreSelections(date) {
    loadAgendaData(date);
    // Após carregar o calendário, restaurar as seleções
    setTimeout(restoreSelectedDates, 300);
}

function renderReservaCalendar(date, agenda) {
    console.log("Renderizando calendário para:", date, "com agenda:", agenda);
    const month = date.getMonth();
    const year = date.getFullYear();
    const currentMonthYearElement = document.getElementById('reservaCurrentMonthYear');
    if (currentMonthYearElement) {
        currentMonthYearElement.textContent = date.toLocaleString('pt-BR', { month: 'long', year: 'numeric' });
    }

    const firstDayOfMonth = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    const calendar = document.getElementById('reservaCalendar');
    if (calendar) {
        // Armazenar as datas atualmente selecionadas antes de redesenhar
        const currentlySelectedDates = [];
        if (selectedDates && Array.isArray(selectedDates)) {
            selectedDates.forEach(item => {
                if (item.date) {
                    currentlySelectedDates.push(item.date);
                }
            });
        }

        calendar.innerHTML = '';

        const weekDays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        weekDays.forEach(day => {
            const dayHeader = document.createElement('div');
            dayHeader.className = 'day-header';
            dayHeader.textContent = day;
            calendar.appendChild(dayHeader);
        });

        for (let i = 0; i < firstDayOfMonth; i++) {
            const emptyDay = document.createElement('div');
            emptyDay.className = 'calendar-day';
            calendar.appendChild(emptyDay);
        }

        for (let day = 1; day <= daysInMonth; day++) {
            const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            const dayInfo = agenda[dateStr];

            const dayElement = document.createElement('div');
            dayElement.className = 'calendar-day';
            dayElement.setAttribute('data-date', dateStr);

            const dayNumberSpan = document.createElement('span');
            dayNumberSpan.className = 'day-number';
            dayNumberSpan.textContent = day;
            dayElement.appendChild(dayNumberSpan);

            if (dayInfo) {
                if (dayInfo.status === 'ativo') {
                    dayElement.classList.add('available');
                    const priceValue = parseFloat(dayInfo.preco.replace(/\./g, '').replace(',', '.'));
                    const formattedPrice = priceValue.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    const priceDiv = document.createElement('div');
                    priceDiv.className = 'price';
                    priceDiv.textContent = formattedPrice;
                    dayElement.appendChild(priceDiv);
                    dayElement.setAttribute('data-price', formattedPrice);
                } else if (dayInfo.status === 'reservado') {
                    dayElement.classList.add('reserved');
                } else if (dayInfo.status === 'pendente') {
                    dayElement.classList.add('pending', 'reserved'); // Usar a mesma classe visual de reservado mas com estilo adicional
                }
            }

            // Restaurar a seleção se a data estava selecionada
            if (currentlySelectedDates.includes(dateStr)) {
                dayElement.classList.add('selected');
            }

            calendar.appendChild(dayElement);
        }
    }
}

// Função para atualizar o display das datas selecionadas (tornada global para ser acessível fora do pageinit)
// Variável global para armazenar as datas selecionadas no contexto do calendário
let selectedDates = [];

function updateSelectedDatesDisplay() {
    const datesList = document.getElementById('selected-dates-list');
    if (datesList) {
        datesList.innerHTML = '';

        let totalPrice = 0;

        selectedDates.forEach((item, index) => {
            const priceValue = parseFloat(item.price.replace('R$', '').replace(/\./g, '').replace(',', '.').trim());
            totalPrice += priceValue;

            const listItem = document.createElement('li');
            listItem.className = 'selected-date-item';
            listItem.innerHTML = `<span class="date-info">${item.formatted} - ${item.price}</span>
                <button class="remove-date-btn btn btn-danger btn-sm" data-index="${index}" style="margin-left: 10px;">Remover</button>`;
            datesList.appendChild(listItem);
        });

        // Atualizar o valor total
        if (selectedDates.length > 0) {
            const formattedTotal = totalPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            const totalPriceElement = document.getElementById('selected-total-price-text');
            const selectedDatesInputElement = document.getElementById('selected_dates_input');
            const totalPriceInputElement = document.getElementById('total_price_input');

            if (totalPriceElement) totalPriceElement.textContent = formattedTotal;
            if (selectedDatesInputElement) selectedDatesInputElement.value = JSON.stringify(selectedDates.map(d => d.date));
            if (totalPriceInputElement) totalPriceInputElement.value = totalPrice;

            const reservaDetails = document.getElementById('reserva-details');
            if (reservaDetails) {
                reservaDetails.style.display = 'block';
            }

            // Atualizar o valor exibido no modal do PIX com base na porcentagem selecionada
            updatePixModalValue();
        } else {
            const totalPriceElement = document.getElementById('selected-total-price-text');
            const selectedDatesInputElement = document.getElementById('selected_dates_input');
            const totalPriceInputElement = document.getElementById('total_price_input');

            if (totalPriceElement) totalPriceElement.textContent = '';
            if (selectedDatesInputElement) selectedDatesInputElement.value = '';
            if (totalPriceInputElement) totalPriceInputElement.value = '';

            const reservaDetails = document.getElementById('reserva-details');
            if (reservaDetails) {
                reservaDetails.style.display = 'none';
            }
        }
    }

    // Save to localStorage whenever the display is updated
    saveSelectedDatesToStorage();
}

// Função para atualizar o valor exibido no modal do PIX (tornada global para ser acessível fora do pageinit)
function updatePixModalValue() {
    if (selectedDates.length > 0) {
        const paymentTypeInputs = document.querySelectorAll('input[name="payment_type"]');
        let selectedPercentage = null;

        for (const input of paymentTypeInputs) {
            if (input.checked) {
                selectedPercentage = input.value;
                break;
            }
        }

        const totalPriceInput = document.getElementById('total_price_input');
        const totalValue = totalPriceInput ? parseFloat(totalPriceInput.value) : 0;
        const paymentValue = (totalValue * parseInt(selectedPercentage || 50)) / 100;
        const formattedValue = paymentValue.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        // Atualizar o valor exibido no modal do PIX se o modal estiver aberto
        const pixValorElement = document.getElementById('pix-valor');
        if (pixValorElement) {
            pixValorElement.textContent = formattedValue;
        }
    }
}

// Script para manipulação do calendário (mantendo a funcionalidade original)
document.addEventListener('DOMContentLoaded', function() {
    // Aguardar até que o DOM esteja completamente carregado e o elemento exista
    const reservaPage = document.getElementById('reservaPageCliente');
    if (reservaPage) {
        const prevMonthBtn = document.getElementById('reservaPrevMonth');
        const nextMonthBtn = document.getElementById('reservaNextMonth');
        const calendarContainer = document.getElementById('reservaCalendar');

        if (prevMonthBtn) {
            prevMonthBtn.addEventListener('click', function() {
                currentDate.setMonth(currentDate.getMonth() - 1);
                selectedDates = []; // Limpar seleções ao mudar de mês
                updateSelectedDatesDisplay();
                loadAgendaData(currentDate);
            });
        }

        if (nextMonthBtn) {
            nextMonthBtn.addEventListener('click', function() {
                currentDate.setMonth(currentDate.getMonth() + 1);
                selectedDates = []; // Limpar seleções ao mudar de mês
                updateSelectedDatesDisplay();
                loadAgendaData(currentDate);
            });
        }

        // Usar event delegation para o calendário
        if (calendarContainer) {
            calendarContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('available') || e.target.closest('.available')) {
                    const target = e.target.classList.contains('available') ? e.target : e.target.closest('.available');
                    const selectedDate = target.getAttribute('data-date');
                    const selectedPrice = target.getAttribute('data-price');
                    const dateObj = new Date(selectedDate + 'T00:00:00');
                    const formattedDate = dateObj.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });

                    // Verificar se a data já está selecionada
                    const existingIndex = selectedDates.findIndex(item => item.date === selectedDate);

                    if (existingIndex >= 0) {
                        // Remover a data se já estiver selecionada
                        selectedDates.splice(existingIndex, 1);
                        target.classList.remove('selected');
                    } else {
                        // Adicionar a data se ainda não estiver selecionada
                        selectedDates.push({date: selectedDate, price: selectedPrice, formatted: formattedDate});
                        target.classList.add('selected');
                    }

                    updateSelectedDatesDisplay();

                    // Show reservation details section if there are selected dates
                    const reservaDetails = document.getElementById('reserva-details');
                    if (reservaDetails && selectedDates.length > 0) {
                        reservaDetails.style.display = 'block';
                    }

                    // Save to localStorage after selection
                    saveSelectedDatesToStorage();
                }
            });
        }

        // Remover data individualmente
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-date-btn') || e.target.closest('.remove-date-btn')) {
                e.stopPropagation();
                const target = e.target.classList.contains('remove-date-btn') ? e.target : e.target.closest('.remove-date-btn');
                const index = parseInt(target.getAttribute('data-index'));
                if (index >= 0 && index < selectedDates.length) {
                    const removedDate = selectedDates[index].date;
                    selectedDates.splice(index, 1);

                    // Remover a classe 'selected' da célula do calendário
                    const calendarDay = document.querySelector(`.calendar-day[data-date="${removedDate}"]`);
                    if (calendarDay) {
                        calendarDay.classList.remove('selected');
                    }

                    updateSelectedDatesDisplay();

                    // Save to localStorage after removal
                    saveSelectedDatesToStorage();
                }
            }
        });

        // Atualizar o valor exibido no modal do PIX quando a porcentagem for alterada
        document.addEventListener('change', function(e) {
            if (e.target.name === 'payment_type') {
                const selectedPercentage = e.target.value;
                const paymentPercentageInput = document.getElementById('payment_percentage_input');
                if (paymentPercentageInput) {
                    paymentPercentageInput.value = selectedPercentage;
                }
                updatePixModalValue();
            }
        });

        loadAgendaData(currentDate);

    }
});

// Adicionar uma verificação adicional para garantir que o calendário apareça

// Função para garantir que o calendário é carregado corretamente em diferentes cenários do jQuery Mobile
function initializeCalendarIfNeeded() {
